{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agent-artifacts",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    { "binding": "ARTIFACTS", "bucket_name": "agent-artifacts-prod" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-artifacts",
      "database_id": "50753730-df63-45f6-800b-6f3b1b5179f8",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SHARE_DOWNLOAD_RATE_LIMITER",
      "namespace_id": "7482101",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "secrets": {
    "required": ["ADMIN_TOKEN"]
  },
  "vars": {
    "MAX_SMALL_UPLOAD_BYTES": "52428800",
    "MULTIPART_PART_SIZE_BYTES": "20971520",
    "DEFAULT_SHARE_TTL_SECONDS": "604800",
    "UPLOAD_SESSION_TTL_SECONDS": "86400",
    "ACCESS_TEAM_DOMAIN": "cool-band-fad1.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "474b498cd34ccab137aa61800402f84dcc1130196e25686c0c2695e1ce7252f6"
  }
}
