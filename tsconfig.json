{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/vitest-pool-workers/types"],
    "lib": ["ES2022", "DOM", "WebWorker"]
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts", "tests/**/*.ts", "tests-node/**/*.ts"]
}
